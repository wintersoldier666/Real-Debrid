<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ghostnotes"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="23" />

    <!-- ZERO internet permission - app is fully offline -->
    <!-- NO network state, NO wifi state, NO bluetooth, NO location -->
    <!-- ONLY storage for internal app data (private by default) -->
    <!-- NO READ_EXTERNAL_STORAGE or WRITE_EXTERNAL_STORAGE -->
    <!-- NO RECEIVE_BOOT_COMPLETED -->

    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:debuggable="false">

        <!-- Login / Unlock screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateVisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notes list -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Note editor -->
        <activity
            android:name=".NoteEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

    </application>

</manifest>
