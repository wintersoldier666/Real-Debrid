<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/facebook_blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingLeft="16dp"
        android:paddingEnd="8dp"
        android:paddingRight="8dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/facebook_white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Loading progress bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:progressTint="@color/facebook_blue"
        android:visibility="gone"
        android:max="100" />

    <!-- Content area (fills remaining space) -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Error view -->
        <LinearLayout
            android:id="@+id/errorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/facebook_white"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Internet"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/facebook_dark"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_no_internet"
                android:textColor="@color/facebook_gray"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/retry"
                android:background="@color/facebook_blue"
                android:textColor="@color/facebook_white"
                android:paddingStart="32dp"
                android:paddingLeft="32dp"
                android:paddingEnd="32dp"
                android:paddingRight="32dp" />

        </LinearLayout>

        <!-- Blocked page view -->
        <LinearLayout
            android:id="@+id/blockedView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/facebook_light_gray"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not Available"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/facebook_dark"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This section is not available.\nOnly Marketplace and Messages are enabled."
                android:textColor="@color/facebook_gray"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnGoMarketplace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Go to Marketplace"
                android:background="@color/facebook_blue"
                android:textColor="@color/facebook_white"
                android:paddingStart="32dp"
                android:paddingLeft="32dp"
                android:paddingEnd="32dp"
                android:paddingRight="32dp" />

    </LinearLayout>

    </FrameLayout>

    <!-- Bottom navigation bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/facebook_white"
        android:orientation="horizontal"
        android:elevation="8dp">

        <!-- Marketplace tab -->
        <LinearLayout
            android:id="@+id/tabMarketplace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconMarketplace"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_marketplace"
                android:tint="@color/nav_selected"
                android:contentDescription="Marketplace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marketplace"
                android:textSize="11sp"
                android:textColor="@color/nav_selected" />

        </LinearLayout>

        <!-- Messages tab -->
        <LinearLayout
            android:id="@+id/tabMessages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconMessages"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_messages"
                android:tint="@color/nav_unselected"
                android:contentDescription="Messages" />

            <TextView
                android:id="@+id/tvMessages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Messages"
                android:textSize="11sp"
                android:textColor="@color/nav_unselected" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
